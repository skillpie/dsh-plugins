{
  "name": "dsh-project-report",
  "version": "0.1.6",
  "description": "Project report for DeepSeek Harness: manual & scheduled reports from git commits and session topics with a configurable daily cutover offset, plus optional automatic Moka overtime submission. Per-project built-in scheduling, no DSH timers needed.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "skillpie",
    "daily-report",
    "git",
    "overtime",
    "moka"
  ],
  "main": "./lib/index.js",
  "repository": {
    "url": "git+https://github.com/skillpie/dsh-plugins.git",
    "directory": "dsh-project-report"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "assets",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
{
  "name": "dsh-plugins-plugin",
  "version": "0.3.1",
  "description": "精选插件:官方插件页「精选推荐」板块的全量嵌入代码库。其他插件执行 `sh integrate.sh --plugin=xxx` 即把完整功能(展示端 UI + 数据端)嵌入 xxx,无需单独安装本包;数据来自仓库集中维护的 plugins.json(jsdelivr 分发)。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "featured-plugins",
    "skillpie"
  ],
  "main": "./embed/featured.host.js",
  "repository": {
    "url": "git+https://github.com/skillpie/dsh-plugins.git",
    "directory": "dsh-plugins-plugin"
  },
  "exports": {
    ".": "./embed/featured.host.js",
    "./host": "./embed/featured.host.js",
    "./client": "./embed/featured.client.js",
    "./standalone": "./lib/index.js",
    "./standalone-client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "embed",
    "lib",
    "plugins.json",
    "locale/*.json",
    "icon.svg",
    "integrate.sh",
    "test",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "dsh-skillpie-mail",
  "version": "0.1.5",
  "description": "SkillPie邮箱：管理 @skillpie.cn 邮箱（快速注册/手动添加/移除），后台 IMAP 轮询，收到新邮件全局弹窗展示并注明收件邮箱。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "skillpie",
    "mail",
    "imap"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "docs",
    "screenshots.json"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillpie/dsh-plugins.git",
    "directory": "dsh-skillpie-mail"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dsh-plugins-plugin": "0.2.0"
  }
}

{
  "name": "dsh-featured",
  "version": "0.1.11",
  "description": "精选插件:官方插件页的精选板块。带搜索栏、分类/标签筛选、申请收录入口。数据由 skillpie 后台数据库管理(插件分类 + 插件列表 + 详情 README),经公开分页接口下发;已接入内联欢迎页的插件会自动让位给本插件。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "featured",
    "featured-plugins",
    "skillpie"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillpie/dsh-plugins.git",
    "directory": "dsh-featured"
  }
}
